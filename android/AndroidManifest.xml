<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yujie.app"
    android:versionCode="7"
    android:versionName="5.1.0">

  <!-- 语界 v5.1: TTS 链路 = 设备本地TTS → speechSynthesis → 内置meSpeak → (可选)网络API
       INTERNET 为可选权限: 离线学习完全不依赖; 仅"在线高音质TTS"与数据备份需要。 -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>

  <!-- Android 11+ 需要 queries 才能发现系统 TTS 引擎 -->
  <queries>
    <intent>
      <action android:name="android.intent.action.TTS_SERVICE"/>
    </intent>
  </queries>

  <application
      android:label="语界"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/AppTheme"
      android:allowBackup="true"
      android:usesCleartextTraffic="true"
      android:networkSecurityConfig="@xml/network_security_config"
      android:hardwareAccelerated="true"
      android:largeHeap="true"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:fullBackupContent="@xml/backup_rules">
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|fontScale"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/AppTheme">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
